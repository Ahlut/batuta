#!/bin/sh
# Pre-push hook — runs automatically before every git push.
# Blocks the push if lint or tests fail.
# Installed via: the project's install script (should run automatically on
# dependency install — see install-hooks.mjs and README.md in this folder).
#
# ADAPT: swap the two commands below for the project's real equivalents
# (e.g. `pnpm lint`, `cargo clippy`, `pytest`, `go test ./...`).

echo "-> Pre-push: checking code quality..."

npm run lint --silent
if [ $? -ne 0 ]; then
  echo "x Lint failed. Fix the errors before pushing."
  exit 1
fi

npm test --silent
if [ $? -ne 0 ]; then
  echo "x Tests failed. Fix the tests before pushing."
  exit 1
fi

echo "OK. Pushing..."
exit 0
